@{
    ViewData["Title"] = "Transfer Funds";
}

<div class="row justify-content-center my-3">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom bg-white p-4">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                        <i class="fa-solid fa-money-bill-transfer fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Direct Fund Transfer</h4>
                        <small class="text-muted">Instant, ACID-compliant money transfer between accounts</small>
                    </div>
                </div>

                <form asp-controller="Transaction" asp-action="Transfer" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="fromAccountId" class="form-label fw-semibold">Source Account ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-wallet"></i></span>
                            <input type="number" 
                                   class="form-control" 
                                   id="fromAccountId" 
                                   name="fromAccountId" 
                                   min="1" 
                                   required 
                                   placeholder="Enter sender account ID (e.g., 1)" />
                        </div>
                        <div class="form-text small">The account from which funds will be deducted.</div>
                    </div>

                    <div class="mb-3">
                        <label for="toAccountId" class="form-label fw-semibold">Destination Account ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-building-columns"></i></span>
                            <input type="number" 
                                   class="form-control" 
                                   id="toAccountId" 
                                   name="toAccountId" 
                                   min="1" 
                                   required 
                                   placeholder="Enter recipient account ID (e.g., 2)" />
                        </div>
                        <div class="form-text small">Must be different from the source account.</div>
                    </div>

                    <div class="mb-3">
                        <label for="amount" class="form-label fw-semibold">Transfer Amount ($ USD)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">$</span>
                            <input type="number" 
                                   class="form-control" 
                                   id="amount" 
                                   name="amount" 
                                   min="1" 
                                   step="0.01" 
                                   required 
                                   placeholder="0.00" />
                        </div>
                        <div class="form-text small">Minimum transfer amount is $1.00.</div>
                    </div>

                    <div class="mb-4">
                        <label for="remarks" class="form-label fw-semibold">Payment Reference / Remarks</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-message"></i></span>
                            <input type="text" 
                                   class="form-control" 
                                   id="remarks" 
                                   name="remarks" 
                                   maxlength="255" 
                                   placeholder="e.g., Monthly invoice settlement" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-paper-plane me-1"></i> Authorize &amp; Execute Transfer
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-transparent border-0 text-center text-muted small pt-0">
                <i class="fa-solid fa-lock text-primary"></i> Protected against race conditions via ordered pessimistic row locks.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
