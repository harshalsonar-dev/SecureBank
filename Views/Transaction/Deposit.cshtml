@{
    ViewData["Title"] = "Deposit Funds";
}

<div class="row justify-content-center my-3">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-custom bg-white p-4">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3">
                        <i class="fa-solid fa-circle-down fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Deposit Funds</h4>
                        <small class="text-muted">Direct balance deposit with immediate ledger reconciliation</small>
                    </div>
                </div>

                <form asp-controller="Transaction" asp-action="Deposit" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="accountId" class="form-label fw-semibold">Target Account ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-wallet"></i></span>
                            <input type="number" 
                                   class="form-control" 
                                   id="accountId" 
                                   name="accountId" 
                                   min="1" 
                                   required 
                                   placeholder="Enter account ID (e.g., 1)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="amount" class="form-label fw-semibold">Deposit Amount ($ USD)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">$</span>
                            <input type="number" 
                                   class="form-control" 
                                   id="amount" 
                                   name="amount" 
                                   min="1" 
                                   step="0.01" 
                                   required 
                                   placeholder="0.00" />
                        </div>
                        <div class="form-text small">Minimum deposit amount is $1.00.</div>
                    </div>

                    <div class="mb-4">
                        <label for="remarks" class="form-label fw-semibold">Deposit Description / Source</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-message"></i></span>
                            <input type="text" 
                                   class="form-control" 
                                   id="remarks" 
                                   name="remarks" 
                                   maxlength="255" 
                                   placeholder="e.g., Branch Teller Deposit" />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-check-circle me-1"></i> Process Deposit
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-transparent border-0 text-center text-muted small pt-0">
                <i class="fa-solid fa-shield-halved text-success"></i> Synchronously committed and audited in SecureBank ledger.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
