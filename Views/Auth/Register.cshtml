@model SecureBank.Models.RegisterViewModel
@{
    ViewData["Title"] = "Open New Account";
}

<div class="row justify-content-center my-3">
    <div class="col-12 col-md-9 col-lg-7 col-xl-6">
        <div class="card card-custom p-4 bg-white">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info rounded-circle mb-3" style="width: 64px; height: 64px;">
                        <i class="fa-solid fa-user-shield fs-2"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Open a SecureBank Account</h3>
                    <p class="text-muted small">Instant checking account opening with cryptographic security</p>
                </div>

                <form asp-controller="Auth" asp-action="Register" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">Legal Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-id-card"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Jane Doe" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-at"></i></span>
                                <input asp-for="Username" class="form-control" placeholder="janedoe" required />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="jane.doe@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-key"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Min. 8 characters" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="InitialDeposit" class="form-label fw-semibold">Opening Deposit ($ USD)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold">$</span>
                                <input asp-for="InitialDeposit" type="number" step="0.01" min="0" class="form-control" placeholder="100.00" />
                            </div>
                            <span asp-validation-for="InitialDeposit" class="text-danger small"></span>
                            <div class="form-text small">A default checking account with an opening balance will be provisioned.</div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-info text-white w-100 py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-check-circle me-1"></i> Create Account
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pt-0 pb-3">
                <small class="text-muted">
                    Already have an account? <a asp-controller="Auth" asp-action="Login" class="fw-semibold text-decoration-none">Sign In</a>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
